pipeline {

    agent any

    tools {

        nodejs 'NodeJS'
    }

    stages {

        stage('Clone Repository') {

            steps {

                git branch: 'main',

                url: 'https://github.com/anushaxoriant/JSPlaywrightFramework.git'
            }
        }

        stage('Install Dependencies') {

            steps {

                bat 'npm install'
            }
        }

        stage('Install Playwright Browsers') {

            steps {

                bat 'npx playwright install'
            }
        }

        stage('Execute Tests') {

            steps {

                bat 'npx playwright test'
            }
        }

        // =====================================
        // DEBUG REPORT
        // =====================================

        stage('Verify Report') {

            steps {

                bat 'dir'

                bat 'dir playwright-report'
            }
        }
    }

    post {

        always {

            publishHTML(target: [

                reportDir: 'playwright-report',

                reportFiles: 'index.html',

                reportName: 'Playwright HTML Report',

                keepAll: true,

                alwaysLinkToLastBuild: true,

                allowMissing: false
            ])
        }
    }
}
