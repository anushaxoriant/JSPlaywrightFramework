pipeline {

    agent any

    tools {

        nodejs 'NodeJS'
    }

    stages {

        stage('Clone Repository') {

            steps {

                git branch: 'main',

                url: 'https://github.com/anushaxoriant/JSPlaywrightFramework.git'
            }
        }

        stage('Install Dependencies') {

            steps {

                bat 'npm install'
            }
        }

        stage('Verify Playwright Installation') {

            steps {

                bat 'npm list @playwright/test'
            }
        }

        stage('Install Browsers') {

            steps {

                bat 'npx playwright install'
            }
        }

        stage('Execute Tests') {

            steps {

                bat 'npx playwright test'
            }
        }
    }
}
